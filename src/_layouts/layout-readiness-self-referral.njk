{% extends "./basic-self-referral.njk" %}
{% from "contents-list/macro.njk" import contentsList %}
{% from "details/macro.njk" import details %}
{% from "button/macro.njk" import button %}
{% from 'card/macro.njk' import card %}



{% block content %}
    {{ super() }}

    

    <section class="nhsuk-section">

        <div class="nhsuk-grid-row">
            {{ card({
                    clickable: false,
                    "heading": "You do not need to do this alone. The NHS 111 online team will support you through every stage.",
                    "headingClasses": "nhsuk-heading-m",
                    "variant": "secondary"
            }) }}
        </div>

        <hr class="nhsuk-section-break nhsuk-section-break--xl nhsuk-section-break--visible">

        <h2 class="nhsuk-heading-l nhsuk-u-margin-bottom-1">The checklist is intended for</h2>
       

        <hr class="nhsuk-section-break nhsuk-section-break--m ">

        <h3 class="nhsuk-heading-m nhsuk-u-margin-bottom-3"></h3>

        
        <ul class="nhsuk-grid-row nhsuk-card-group">  
            <li class="nhsuk-grid-column-one-third nhsuk-card-group__item">    
                {{ card({
                    clickable: false,
                    "heading": "Trusts",
                    "headingClasses": "nhsuk-heading-s",
                    "variant": "secondary"
                }) }}
            </li>
            <li class="nhsuk-grid-column-one-third nhsuk-card-group__item">    
                {{ card({
                    clickable: false,
                    "heading": "Cancer Alliances",
                    "headingClasses": "nhsuk-heading-s",
                    "variant": "secondary"
                }) }}
            </li>
            <li class="nhsuk-grid-column-one-third nhsuk-card-group__item">    
                {{ card({
                    clickable: false,
                    "heading": "Clinical & operational leads",
                    "headingClasses": "nhsuk-heading-s",
                    "variant": "secondary"
                }) }}
            </li>
        </ul>


        <div class="nhsuk-grid-row"  style="background-color:white;">
            <hr class="nhsuk-section-break nhsuk-section-break--l" > 
            <div class="nhsuk-grid-column-one-half nhsuk-u-margin-bottom-1">
                <img src="/nhs111-resources/images/self-referral-trust-checklist.webp" alt="an image of a checklist with a woman and pencil in an illustrated style">
            </div>
            <div class="nhsuk-grid-column-one-half nhsuk-u-margin-bottom-1">
                <h2 class="nhsuk-heading-l nhsuk-u-margin-bottom-5">Trust readiness checklist</h2>
                <p class="nhsuk-body">A checklist of all activities your trust needs to complete before going live.</p>
        
                {# File removed pending content review - button kept but disabled until a replacement/decision is made #}
                {{- button({
                    "text": "Download checklist",
                    "classes": "nhsuk-button--secondary",
                    "disabled": true
                }) -}}
            </div>
        </div>


    </section>

    <hr class="nhsuk-section-break nhsuk-section-break--l" >   

    <section class="nhsuk-section">

        <h2 class="nhsuk-heading-l nhsuk-u-margin-bottom-5">What the checklist covers</h2>
        <ul>
            <li>Identifying operation, clinical and onboarding leads</li>
            <li>Completing AS-IS and TO-BE workshops with the NHS 111 team</li>
            <li>Developing and approving a new standard operating procedure (SOP)</li>
            <li>Agreeing data reporting, referral management, and communication approaches</li>
            <li>Testing and confirming a go-live data</li>
        </ul>
    

    </section>

     <hr class="nhsuk-section-break nhsuk-section-break--xl">
    <hr class="nhsuk-section-break nhsuk-section-break--xl nhsuk-section-break--visible">

    <section class="nhsuk-section">
        
        <h2 class="nhsuk-heading-l nhsuk-u-margin-bottom-5">Quick links</h2>

            {{ contentsList({
                items: [
                    {
                    href: "#",
                    text: "FAQs",
                    current: false
                    },
                    {
                    href: "#",
                    text: "Demos"
                    },
                    {
                    href: "#",
                    text: "Onboarding pack"
                    }
                ]
            }) }}
    </section> 
   
   

{% endblock %}
